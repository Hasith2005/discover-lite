{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github@2025.4.8"],
      "env": {"GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"}
    },
    "docs-search": {
      "type": "http",
      "url": "https://docs-search.example.com/mcp",
      "headers": {"Authorization": "Bearer ${DOCS_SEARCH_TOKEN}"}
    }
  }
}
