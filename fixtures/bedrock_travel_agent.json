{
  "agent": {
    "agentId": "TRAVEL0001",
    "agentName": "Travel Booker",
    "agentArn": "arn:aws:bedrock:eu-west-2:111122223333:agent/TRAVEL0001",
    "agentStatus": "PREPARED",
    "foundationModel": "anthropic.claude-sonnet-4-5",
    "instruction": "You are a travel assistant. Help employees book flights."
  },
  "actionGroups": [
    {
      "actionGroupName": "flights",
      "actionGroupState": "ENABLED",
      "actionGroupExecutor": {
        "lambda": "arn:aws:lambda:eu-west-2:111122223333:function:flights"
      },
      "functionSchema": {
        "functions": [
          {
            "name": "search_flights",
            "description": "Find flights between two airports."
          },
          {
            "name": "book_flight",
            "description": "Book a flight.",
            "requireConfirmation": "ENABLED"
          },
          {
            "name": "cancel_booking",
            "description": "Cancel a booking.",
            "requireConfirmation": "DISABLED"
          }
        ]
      }
    },
    {
      "actionGroupName": "hotels",
      "actionGroupState": "ENABLED",
      "actionGroupExecutor": {
        "lambda": "arn:aws:lambda:eu-west-2:111122223333:function:hotels"
      },
      "apiSchema": {
        "payload": "{\"openapi\": \"3.0.0\", \"info\": {\"title\": \"Hotels API\", \"version\": \"1.0.0\"}, \"paths\": {\"/hotels\": {\"get\": {\"operationId\": \"searchHotels\", \"description\": \"Search hotels in a city.\"}}, \"/hotels/{hotelId}/reservations\": {\"post\": {\"operationId\": \"reserveHotel\", \"description\": \"Reserve a room.\"}}}}"
      }
    },
    {
      "actionGroupName": "code",
      "actionGroupState": "ENABLED",
      "parentActionGroupSignature": "AMAZON.CodeInterpreter"
    },
    {
      "actionGroupName": "old-expenses",
      "actionGroupState": "DISABLED",
      "functionSchema": {
        "functions": [
          {
            "name": "delete_expense",
            "requireConfirmation": "DISABLED"
          }
        ]
      }
    }
  ]
}